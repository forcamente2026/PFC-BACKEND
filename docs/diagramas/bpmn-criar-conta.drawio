          <mxGeometry x="1240" y="1000" width="300" height="90" as="geometry" />
        </mxCell>
        <mxCell id="n1e" style="html=1;dashed=1;endArrow=none;strokeColor=#d6b656;strokeWidth=2;exitX=0.5;exitY=0;exitDx=0;exitDy=0;" edge="1" parent="1" source="n1" target="G2"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="n2" value="&lt;b&gt;Motivos de recusa&lt;/b&gt;&lt;br&gt;RN01 — menos de 18 anos&lt;br&gt;RN02 — e-mail já cadastrado&lt;br&gt;RN03 — senha fora das regras&lt;br&gt;RN08 — CREF inválido ou já usado&lt;br&gt;RN09 — endereço profissional incompleto" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FBE9E7;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="3420" y="1000" width="290" height="135" as="geometry" />
        </mxCell>
        <mxCell id="n2e" style="html=1;dashed=1;endArrow=none;strokeColor=#b85450;strokeWidth=2;exitX=0.5;exitY=0;exitDx=0;exitDy=0;" edge="1" parent="1" source="n2" target="G6"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="n3" value="&lt;b&gt;RN05&lt;/b&gt; — a data do aceite e a versão vigente de cada documento são carimbadas pelo servidor, nunca enviadas pelo navegador: é o que dá valor de prova ao consentimento.&lt;br&gt;&lt;b&gt;RN04&lt;/b&gt; — a senha é gravada apenas como hash.&lt;br&gt;&lt;b&gt;RN07&lt;/b&gt; — conta de aluno não guarda CREF, formação nem endereço, mesmo que sejam enviados." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#E8F5E9;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="3760" y="1000" width="340" height="155" as="geometry" />
        </mxCell>
        <mxCell id="n3e" style="html=1;dashed=1;endArrow=none;strokeColor=#82b366;strokeWidth=2;exitX=0.2;exitY=0;exitDx=0;exitDy=0;" edge="1" parent="1" source="n3" target="B7"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="legenda" value="Legenda BPMN" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fillColor=#FAFAFA;strokeColor=#999999;fontSize=14;fontStyle=1;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="1000" width="1060" height="186" as="geometry" />
        </mxCell>
        <mxCell id="lb1" value="&lt;b&gt;Círculo fino verde&lt;/b&gt; — evento de início   |   &lt;b&gt;Círculo grosso vermelho&lt;/b&gt; — evento de fim" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=12;fontSize=12;" vertex="1" parent="legenda"><mxGeometry y="30" width="1060" height="24" as="geometry" /></mxCell>
        <mxCell id="lb2" value="&lt;b&gt;Retângulo arredondado&lt;/b&gt; — atividade   |   &lt;b&gt;Losango&lt;/b&gt; — decisão exclusiva: segue por um caminho só" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=12;fontSize=12;" vertex="1" parent="legenda"><mxGeometry y="54" width="1060" height="24" as="geometry" /></mxCell>
        <mxCell id="lb3" value="&lt;b&gt;Linha cheia com ponta preenchida&lt;/b&gt; — fluxo de sequência, dentro do mesmo participante" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=12;fontSize=12;" vertex="1" parent="legenda"><mxGeometry y="78" width="1060" height="24" as="geometry" /></mxCell>
        <mxCell id="lb4" value="&lt;b&gt;Linha tracejada com ponta vazada&lt;/b&gt; — fluxo de mensagem, entre participantes diferentes (ForçaMente e ViaCEP)" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=12;fontSize=12;" vertex="1" parent="legenda"><mxGeometry y="102" width="1060" height="24" as="geometry" /></mxCell>
        <mxCell id="lb5" value="&lt;b&gt;Laranja&lt;/b&gt; — caminho alternativo que não impede o cadastro   |   &lt;b&gt;Vermelho&lt;/b&gt; — recusa   |   &lt;b&gt;Verde&lt;/b&gt; — conclusão com sucesso" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=12;fontSize=12;" vertex="1" parent="legenda"><mxGeometry y="126" width="1060" height="24" as="geometry" /></mxCell>
        <mxCell id="lb6" value="As notas citam as regras de negócio (RN) do documento de requisitos, versão 2.0 de 02/10/2026." style="text;html=1;align=left;verticalAlign=middle;spacingLeft=12;fontSize=12;fontColor=#666666;" vertex="1" parent="legenda"><mxGeometry y="150" width="1060" height="24" as="geometry" /></mxCell>

      </root>
    </mxGraphModel>
  </diagram>
