        <mxCell id="r_nota" value="&lt;b&gt;Referência fraca entre RegistroAuditoriaEntity e UsuarioEntity&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;usuarioId&lt;/i&gt; guarda o identificador do autor da ação, mas &lt;b&gt;não existe chave estrangeira&lt;/b&gt; para a tabela de usuários. A ligação é resolvida em tempo de leitura, pelo serviço, e por isso está representada como dependência (linha tracejada) e não como associação.&lt;br&gt;&lt;br&gt;É decisão de projeto: a anonimização irreversível apaga os dados pessoais do titular, e uma chave estrangeira impediria isso ou destruiria o histórico. Desacoplada, a trilha sobrevive e o registro passa a exibir o nome anonimizado.&lt;br&gt;&lt;br&gt;Pelo mesmo motivo &lt;i&gt;usuarioId&lt;/i&gt; aceita nulo: ações anteriores à autenticação não têm autor identificado." style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#FFFFFF;strokeColor=#000000;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontFamily=Arial;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="1520" y="120" width="420" height="270" as="geometry" />
        </mxCell>

        <mxCell id="r_legenda" value="&lt;b&gt;Convenções — notação Rational Rose&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;startSize=28;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;fontStyle=0;verticalAlign=middle;align=center;fontFamily=Arial;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="1520" y="430" width="700" height="218" as="geometry" />
        </mxCell>
        <mxCell id="rz1" value="Classe em três compartimentos: nome, atributos e operações." style="text;html=1;align=left;verticalAlign=middle;spacingLeft=10;fontSize=11;fontFamily=Arial;" vertex="1" parent="r_legenda"><mxGeometry y="28" width="700" height="22" as="geometry" /></mxCell>
        <mxCell id="rz2" value="Operações: os oito enums expõem getDescricao(). As quatro entidades não declaram método algum." style="text;html=1;align=left;verticalAlign=middle;spacingLeft=10;fontSize=11;fontFamily=Arial;" vertex="1" parent="r_legenda"><mxGeometry y="50" width="700" height="22" as="geometry" /></mxCell>
        <mxCell id="rz3" value="&amp;laquo;estereótipo&amp;raquo; acima do nome, em guilhemés, sem negrito." style="text;html=1;align=left;verticalAlign=middle;spacingLeft=10;fontSize=11;fontFamily=Arial;" vertex="1" parent="r_legenda"><mxGeometry y="72" width="700" height="22" as="geometry" /></mxCell>
        <mxCell id="rz4" value="Visibilidade: &lt;b&gt;-&lt;/b&gt; privado. Todos os atributos do domínio são privados." style="text;html=1;align=left;verticalAlign=middle;spacingLeft=10;fontSize=11;fontFamily=Arial;" vertex="1" parent="r_legenda"><mxGeometry y="94" width="700" height="22" as="geometry" /></mxCell>
        <mxCell id="rz5" value="Linha cheia sem ponta: associação, com multiplicidade junto à classe de destino." style="text;html=1;align=left;verticalAlign=middle;spacingLeft=10;fontSize=11;fontFamily=Arial;" vertex="1" parent="r_legenda"><mxGeometry y="116" width="700" height="22" as="geometry" /></mxCell>
        <mxCell id="rz6" value="Linha tracejada com ponta aberta: dependência." style="text;html=1;align=left;verticalAlign=middle;spacingLeft=10;fontSize=11;fontFamily=Arial;" vertex="1" parent="r_legenda"><mxGeometry y="138" width="700" height="22" as="geometry" /></mxCell>
        <mxCell id="rz7" value="Modelo anêmico: comportamento nos serviços. Sem herança, agregação ou composição." style="text;html=1;align=left;verticalAlign=middle;spacingLeft=10;fontSize=11;fontFamily=Arial;" vertex="1" parent="r_legenda"><mxGeometry y="160" width="700" height="22" as="geometry" /></mxCell>
        <mxCell id="rz8" value="ARTIGO, em cinza, é valor previsto no enum e ainda sem implementação." style="text;html=1;align=left;verticalAlign=middle;spacingLeft=10;fontSize=11;fontFamily=Arial;fontColor=#555555;" vertex="1" parent="r_legenda"><mxGeometry y="182" width="700" height="22" as="geometry" /></mxCell>

